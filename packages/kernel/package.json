{
  "name": "@venizia/ardor-kernel",
  "version": "0.4.6-1",
  "description": "ARDOR kernel - the isomorphic core of the ARDOR frontend framework: application base on IGNIS inversion, service and provider bases, request/auth constants, binding keys, logger, the network request service, runtime config and the HTTP repository (from IGNIS). No React and no react-admin.",
  "keywords": [
    "ardor",
    "ardor-kernel",
    "browser",
    "dependency-injection",
    "fetch",
    "framework",
    "ignis",
    "inversion-of-control",
    "isomorphic",
    "logger",
    "network",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ardor.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ardor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ardor.git",
    "directory": "packages/kernel"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/base/repositories/index.d.ts",
      "import": "./dist/base/repositories/index.js",
      "default": "./dist/base/repositories/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "catalog:",
    "@types/bun": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-connectors": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-helpers": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "@venizia/ignis-kernel": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "reflect-metadata": "catalog:",
    "size-limit": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@venizia/ignis-connectors": "^0.4.1",
    "@venizia/ignis-filter": "^0.4.1",
    "@venizia/ignis-helpers": "^0.4.1",
    "@venizia/ignis-inversion": "^0.4.1",
    "@venizia/ignis-kernel": "^0.4.1",
    "reflect-metadata": ">=0.2.2"
  },
  "peerDependenciesMeta": {
    "@venizia/ignis-connectors": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "@venizia/ignis-filter",
        "@venizia/ignis-inversion",
        "reflect-metadata"
      ],
      "limit": "7 KB"
    }
  ],
  "engines": {
    "bun": ">=1.4"
  }
}
