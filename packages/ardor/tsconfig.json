{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.browser.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declarationDir": "dist",

    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,

    // Restated, not inherited: the base sets them, but Bun ignores an `extends` that names a
    // package, so `bun test` sees none of it. Without these lines it compiles TC39 decorators (every
    // @provide/@inject breaks) and defines class fields unlike the `dist` that tsc emits.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
