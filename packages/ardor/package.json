{
  "name": "@venizia/ardor",
  "version": "0.4.5",
  "description": "ARDOR - frontend application framework for the VENIZIA family. One entry point over ardor-kernel, ardor-react and ardor-admin: IGNIS inversion of control, a REST data layer, auth and i18n providers, and the React bindings for a react-admin application.",
  "keywords": [
    "ardor",
    "dependency-injection",
    "framework",
    "frontend",
    "ignis",
    "inversion-of-control",
    "ra-core",
    "react",
    "react-admin",
    "rest",
    "spa",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ardor.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ardor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ardor.git",
    "directory": "packages/ardor"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js",
      "default": "./dist/repository.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@venizia/ardor-admin": "workspace:*",
    "@venizia/ardor-kernel": "workspace:*",
    "@venizia/ardor-react": "workspace:*"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-boot": "catalog:",
    "@venizia/ignis-connectors": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-helpers": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "@venizia/ignis-kernel": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "size-limit": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": ">=2.13.0",
    "@tanstack/react-query": ">=5.104.5",
    "@venizia/ignis-boot": "^0.4.1",
    "@venizia/ignis-connectors": "^0.4.1",
    "@venizia/ignis-filter": "^0.4.1",
    "@venizia/ignis-helpers": "^0.4.1",
    "@venizia/ignis-inversion": "^0.4.4",
    "@venizia/ignis-kernel": "^0.4.1",
    "ra-core": ">=5.15.5",
    "ra-i18n-polyglot": ">=5.15.5",
    "react": ">=19.3.1",
    "react-dom": ">=19.3.1",
    "react-redux": ">=9.3.0",
    "react-router-dom": ">=7.18.4",
    "reflect-metadata": ">=0.2.2",
    "vite": ">=8.3.5"
  },
  "peerDependenciesMeta": {
    "@venizia/ignis-boot": {
      "optional": true
    },
    "@venizia/ignis-connectors": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "@reduxjs/toolkit",
        "@tanstack/react-query",
        "@venizia/ardor-admin",
        "@venizia/ardor-kernel",
        "@venizia/ardor-react",
        "@venizia/ignis-filter",
        "@venizia/ignis-inversion",
        "ra-core",
        "react",
        "react-dom",
        "react-redux",
        "react-router-dom",
        "reflect-metadata"
      ],
      "limit": "350 B"
    },
    {
      "path": "dist/testing.js",
      "import": "*",
      "ignore": [
        "@reduxjs/toolkit",
        "@tanstack/react-query",
        "@venizia/ardor-admin",
        "@venizia/ardor-kernel",
        "@venizia/ardor-react",
        "@venizia/ignis-filter",
        "@venizia/ignis-inversion",
        "ra-core",
        "react",
        "react-dom",
        "react-redux",
        "react-router-dom",
        "reflect-metadata"
      ],
      "limit": "900 B"
    }
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "vulcan": {
    "presets": {
      "app": "./dist/presets/app/preset.json",
      "lib": "./dist/presets/lib/preset.json"
    }
  }
}
