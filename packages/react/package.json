{
  "name": "@venizia/ardor-react",
  "version": "0.4.6-1",
  "description": "ARDOR React bindings - the application context, the injectable and logger hooks that read it, typed Redux hook factories, and the framework-agnostic UI hooks (debounce, autosave, confirm, clipboard, sizer, window dimensions). No react-admin.",
  "keywords": [
    "ardor",
    "ardor-react",
    "context",
    "dependency-injection",
    "hooks",
    "ignis",
    "react",
    "react-hooks",
    "react-redux",
    "typescript",
    "venizia"
  ],
  "homepage": "https://ardor.venizia.ai",
  "bugs": {
    "url": "https://github.com/VENIZIA-AI/ardor/issues"
  },
  "license": "MIT",
  "author": {
    "name": "VENIZIA AI Developer",
    "email": "developer@venizia.ai",
    "url": "https://venizia.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VENIZIA-AI/ardor.git",
    "directory": "packages/react"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "dist",
    "!/**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "force-update": "sh ../../scripts/build/force-update.sh",
    "prepublishOnly": "make rebuild"
  },
  "dependencies": {
    "@venizia/ardor-kernel": "workspace:*",
    "lodash": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/lodash": "catalog:",
    "@types/react": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-helpers": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "@venizia/ignis-kernel": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:",
    "reflect-metadata": "catalog:",
    "size-limit": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": ">=2.13.0",
    "@venizia/ignis-filter": "^0.4.1",
    "@venizia/ignis-helpers": "^0.4.1",
    "@venizia/ignis-inversion": "^0.4.1",
    "@venizia/ignis-kernel": "^0.4.1",
    "react": ">=19.3.1",
    "react-redux": ">=9.3.0",
    "reflect-metadata": ">=0.2.2"
  },
  "peerDependenciesMeta": {
    "@reduxjs/toolkit": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "import": "*",
      "ignore": [
        "@reduxjs/toolkit",
        "@venizia/ardor-kernel",
        "@venizia/ignis-inversion",
        "lodash",
        "react",
        "react-redux"
      ],
      "limit": "2.5 KB"
    }
  ],
  "engines": {
    "bun": ">=1.4"
  }
}
