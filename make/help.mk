# `make help` - the target list. Keep it in step with the other make/*.mk files.
# Every row goes through HELP_ROW, so the descriptions start in one column; widen HELP_WIDTH when
# a longer name is added. The knowledge bundle's make-target table reads these rows.

HELP_WIDTH := 28
HELP_ROW = printf "  %-$(HELP_WIDTH)s %s\n"

.PHONY: help

help:
	@echo "Makefile for the ARDOR monorepo"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Main Targets:"
	@$(HELP_ROW) "help" "Show this help message (a bare 'make' does the same)."
	@$(HELP_ROW) "build" "Rebuilds all packages (alias for 'build-all')."
	@$(HELP_ROW) "build-all" "Rebuilds all packages in dependency order."
	@$(HELP_ROW) "install" "Install all dependencies with bun."
	@$(HELP_ROW) "clean" "Clean build artifacts from all packages."
	@$(HELP_ROW) "setup-hooks" "Configure git to use .githooks directory."
	@$(HELP_ROW) "docs" "Build the wiki (VitePress) with the sidebar gate."
	@$(HELP_ROW) "typecheck / typecheck-all" "Type-check every package (tests included) without emitting."
	@$(HELP_ROW) "typecheck-examples" "Type-check every example against the built packages. Needs a build."
	@echo ""
	@echo "Per package - <pkg> is one of:"
	@echo "  $(PACKAGES)"
	@$(HELP_ROW) "<pkg>" "Rebuild one package, after its dependencies."
	@$(HELP_ROW) "update-<pkg>" "Force update one package's dependencies from NPM."
	@$(HELP_ROW) "lint-<pkg>" "oxlint + ESLint (naming-convention) + bun fmt check of one package."
	@$(HELP_ROW) "lint-fix-<pkg>" "Apply oxlint --fix, ESLint --fix and bun fmt to one package."
	@$(HELP_ROW) "test-<pkg>" "Run one package's suite with BUN_TEST_FLAGS. Needs a build."
	@$(HELP_ROW) "purity-<pkg>" "Gate: one package's browser-pure entries. Needs a build."
	@$(HELP_ROW) "clean-install-<pkg>" "Load one package's sub-paths from a clean install. Needs a build."
	@echo ""
	@echo "Every package:"
	@$(HELP_ROW) "lint / lint-packages" "lint-<pkg> for every package."
	@$(HELP_ROW) "lint-all" "lint-packages, lint-wiki, lint-scripts and lint-files."
	@$(HELP_ROW) "lint-fix / lint-fix-packages" "lint-fix-<pkg> for every package."
	@$(HELP_ROW) "test / test-all" "test-<pkg> for every package; one with no suite says so and passes."
	@$(HELP_ROW) "gates" "The Test job of the release workflow, locally: links, build, lint, test, scripts, purity, catalog, preset smoke. Run without -j."
	@$(HELP_ROW) "links-check" "Gate: every ARDOR sibling resolves to the workspace, not to the registry."
	@$(HELP_ROW) "purity" "Gate: every entry claimed browser-pure has no node builtin or global."
	@$(HELP_ROW) "clean-install" "Load every published sub-path from packed tarballs in an empty project."
	@$(HELP_ROW) "layer-check" "Gate: no package imports a layer above it."
	@$(HELP_ROW) "cycles-check" "Gate: no import cycle in any dist. Needs a build."
	@$(HELP_ROW) "size-check" "Gate: every bundle within its size-limit budget. Needs a build."
	@echo ""
	@echo "Repository scripts and wiki:"
	@$(HELP_ROW) "lint-scripts" "Format check + bun check type-check of scripts/."
	@$(HELP_ROW) "lint-wiki" "Lint docs/wiki and check its format."
	@$(HELP_ROW) "lint-fix-wiki" "Apply the lint fixes and bun fmt to docs/wiki."
	@$(HELP_ROW) "lint-files" "Format check of the files outside the projects: the root package.json, workflows, .agents, .configs, the presets, the examples."
	@$(HELP_ROW) "fmt-files" "Format those files with bun fmt (part of lint-fix)."
	@$(HELP_ROW) "fmt-scripts" "Format scripts/ with bun fmt (part of lint-fix; lint-scripts checks it)."
	@$(HELP_ROW) "test-scripts" "Run the repository gate scripts' own regression tests."
	@$(HELP_ROW) "purity-test" "Run the purity gate's regression tests (the shared engine on ARDOR's fixtures)."
	@echo ""
	@echo "Knowledge bundle (.agents/knowledge):"
	@$(HELP_ROW) "okf-check" "Check the knowledge bundle against OKF v0.2."
	@$(HELP_ROW) "okf-check-strict" "Gate: okf-check plus links, style, coverage, freshness."
	@$(HELP_ROW) "okf-gen" "Regenerate source-derived reference content."
	@$(HELP_ROW) "okf-coverage" "Report bundle coverage against the source inventory."
	@$(HELP_ROW) "okf-viz" "Build the offline knowledge-graph explorer."
	@$(HELP_ROW) "split-report" "Report hub files, stray types, missing barrels, long files, cycles (informational)."
	@$(HELP_ROW) "surface-gen" "Snapshot every exported symbol into .agents/knowledge/reference/public-surface.md."
	@$(HELP_ROW) "surface-check" "Gate: the public surface equals the snapshot."
	@$(HELP_ROW) "atlas-symbols" "Print the symbols atlas reads from the built .d.ts. Needs a build."
	@$(HELP_ROW) "atlas-releases" "Print the release table atlas computes from the tags."
	@$(HELP_ROW) "changelogs-migrate" "Write the packages: list into changelog entries that declare none."
	@$(HELP_ROW) "wiki-links-check" "Gate: every source path the wiki and knowledge bundle name exists."
	@$(HELP_ROW) "wiki-anchors-check" "Gate: every wiki '#fragment' link resolves. Needs a build (make docs)."
	@$(HELP_ROW) "atlas-smoke" "Gate: VULCAN's atlas serves this checkout over MCP."
	@$(HELP_ROW) "vulcan-sync" "Write your agent adapters: CLAUDE.md, .claude/settings.json, skill links."
	@$(HELP_ROW) "vulcan-doctor" "Gate: the project follows VULCAN (config, layout, rules, make, adapters, style)."
	@$(HELP_ROW) "agent-setup" "Alias of vulcan-sync."
	@echo ""
	@echo "Release and dependencies:"
	@$(HELP_ROW) "release-plan" "Print the release plan (dependency order), dispatch nothing."
	@$(HELP_ROW) "release ARGS=\"...\"" "Dispatch the release workflow once for the four packages (a prerelease from develop, a stable from main), e.g. ARGS=\"--yes\"."
	@$(HELP_ROW) "catalog-check" "Gate: every catalogued dep is referenced as \"catalog:\", none drifted."
	@echo ""
	@echo "Development (use bun run directly):"
	@$(HELP_ROW) "bun run docs:dev" "Start documentation site in development mode."
