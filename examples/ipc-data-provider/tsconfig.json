{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.browser.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "noEmit": true,

    // Restated, not inherited: Bun ignores an `extends` that names a package.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
