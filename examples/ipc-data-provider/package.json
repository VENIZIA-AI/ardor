{
  "name": "ipc-data-provider",
  "version": "0.0.0",
  "private": true,
  "description": "DefaultRestDataProvider.send overridden for a non-HTTP transport - the pattern a desktop (Tauri) shell uses - run as a Bun script with no server",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "bun run src/index.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check --no-pretty -p tsconfig.json",
    "lint": "devz lint",
    "lint:fix": "devz lint --fix",
    "test": "bun test --pass-with-no-tests",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@venizia/ardor": "workspace:*",
    "react": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
