{
  "name": "ipc-data-provider",
  "version": "0.0.0",
  "private": true,
  "description": "DefaultRestDataProvider.send overridden for a non-HTTP transport - the pattern a desktop (Tauri) shell uses - run as a Bun script with no server",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun run typecheck",
    "clean": "rm -rf *.tsbuildinfo",
    "lint": "oxlint -c .configs/oxlint.config.mts --deny-warnings && eslint -c .configs/eslint.config.mts . && oxfmt -c .configs/oxfmt.config.mts --check \"**/*.{js,mjs,ts,mts}\"",
    "lint:fix": "oxlint -c .configs/oxlint.config.mts --fix && eslint -c .configs/eslint.config.mts . --fix && oxfmt -c .configs/oxfmt.config.mts \"**/*.{js,mjs,ts,mts}\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@venizia/ardor": "workspace:*",
    "@venizia/ardor-admin": "workspace:*",
    "@venizia/ardor-react": "workspace:*",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "ra-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
