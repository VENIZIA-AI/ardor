{
  "name": "5-mins-qs",
  "version": "0.0.0",
  "private": true,
  "description": "5-minute quickstart: one ARDOR application, one service, one resource page, and a stub API to run it against",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "api": "bun run api/server.ts",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p api/tsconfig.json",
    "lint": "oxlint -c .configs/oxlint.config.mts --deny-warnings && eslint -c .configs/eslint.config.mjs . && oxfmt -c .configs/oxfmt.config.mts --check \"**/*.{js,mjs,ts,mts,tsx}\"",
    "lint:fix": "oxlint -c .configs/oxlint.config.mts --fix && eslint -c .configs/eslint.config.mjs . --fix && oxfmt -c .configs/oxfmt.config.mts \"**/*.{js,mjs,ts,mts,tsx}\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@venizia/ardor": "workspace:*",
    "@venizia/ignis-connectors": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "ra-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.10"
  }
}
