{
  "name": "5-mins-qs",
  "version": "0.0.0",
  "private": true,
  "description": "5-minute quickstart: one ARDOR application, one service, one resource page, and a stub API to run it against",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "server:dev": "sh scripts/server-dev.sh",
    "compile": "sh scripts/compile.sh",
    "typecheck": "sh scripts/typecheck.sh",
    "lint": "sh scripts/lint.sh",
    "lint:fix": "sh scripts/lint.sh --fix",
    "test": "bun test --pass-with-no-tests",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@venizia/ardor": "workspace:*",
    "@venizia/ardor-admin": "workspace:*",
    "@venizia/ignis-connectors": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "ra-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-boot": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
