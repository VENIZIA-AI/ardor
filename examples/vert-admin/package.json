{
  "name": "vert-admin",
  "version": "0.0.0",
  "private": true,
  "description": "The family reference: an ARDOR admin console over IGNIS's `examples/vert` API - sign-in through the IGNIS auth component, token refresh, RBAC-gated pages, CRUD on configurations",
  "type": "module",
  "scripts": {
    "server:dev": "vite --config .configs/builders/vite.config.ts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check --no-pretty -p tsconfig.json",
    "lint": "devz lint",
    "lint:fix": "devz lint --fix",
    "test": "bun test --pass-with-no-tests",
    "clean": "sh scripts/clean.sh"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@venizia/ardor": "workspace:*",
    "@venizia/ignis-inversion": "catalog:",
    "ra-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-boot": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
