{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@venizia/dev-configs/tsconfig.react.json",
  "compilerOptions": {
    "types": ["vite/client", "bun"],
    "noEmit": true,
    "isolatedModules": true,

    // Restated, not inherited: Bun ignores an `extends` that names a package.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "include": ["src", ".configs/builders/vite.config.mts"]
}
