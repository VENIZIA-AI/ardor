# The nginx configuration of {{app}}, rendered by the base image at start. Its own variables ($uri,
# $host) are nginx's, not the image's. Two things are included from /etc/nginx/snippets and
# /etc/nginx/conf.d, both put there by the Dockerfile and the entrypoint script 45-api-proxy.sh:
#
#   security-headers.conf   the response headers every location sends
#   *.locations             the /api proxy, written only when API_UPSTREAM is set and not empty
server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Text is compressed (html always is). Images and fonts are already compressed: leave them out.
  gzip on;
  gzip_vary on;
  gzip_min_length 256;
  gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml;

  # nginx inherits add_header from the server only into a location that sets none of its own, and every
  # location below sets Cache-Control. So each one includes the same snippet again: a header added to
  # the snippet reaches all of them.
  include /etc/nginx/snippets/security-headers.conf;

  # For a load balancer or an orchestrator: answers from nginx alone, never from the backend.
  location = /health {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store";
    include /etc/nginx/snippets/security-headers.conf;
    return 200 "ok\n";
  }

  # The backend, when API_UPSTREAM is set: /api/hello reaches the upstream at /api/hello. An app that is served
  # behind a gateway leaves API_UPSTREAM empty, and no /api location exists. See snippets/api-proxy.conf.
  include /etc/nginx/conf.d/*.locations;

  # The runtime config is written when the container starts and has no hash in its name: never cached.
  location = /config.js {
    add_header Cache-Control "no-store";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # The built files carry a content hash in their name, so a browser may keep them for good.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # A route of the app, opened or reloaded directly, is served by the app.
  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
