{
  "presetVersion": 1,
  "side": "frontend",
  "summary": "An ARDOR admin on Vite and React: one products resource with list, create and edit pages, REST data provider and i18n, no sign-in.",
  "devPort": 5173,
  "imports": { "#src/*.json": "./src/*.json", "#src/*": "./src/*.js" },
  "urls": ["/"],
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@venizia/ardor": "workspace:*",
    "@venizia/ignis-connectors": "catalog:",
    "@venizia/ignis-filter": "catalog:",
    "@venizia/ignis-helpers": "catalog:",
    "@venizia/ignis-inversion": "catalog:",
    "@venizia/ignis-kernel": "catalog:",
    "ra-core": "catalog:",
    "ra-i18n-polyglot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "react-router-dom": "catalog:",
    "reflect-metadata": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@venizia/dev-configs": "catalog:",
    "@venizia/ignis-boot": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peers": {
    "@venizia/ignis-connectors": "peer:",
    "@venizia/ignis-filter": "peer:",
    "@venizia/ignis-helpers": "peer:",
    "@venizia/ignis-inversion": "peer:",
    "@venizia/ignis-kernel": "peer:"
  },
  "scripts": {
    "server:dev": "vite --config .configs/builders/vite.config.mts",
    "compile": "sh scripts/compile.sh",
    "typecheck": "bun check --no-pretty -p tsconfig.json",
    "lint": "devz lint",
    "lint:fix": "devz lint --fix",
    "test": "bun test",
    "clean": "sh scripts/clean.sh"
  },
  "checks": ["typecheck", "lint", "test", "compile"],
  "files": "./files",
  "atlas": [
    { "name": "ardor", "repo": "VENIZIA-AI/ardor", "ref": "develop" },
    { "name": "ignis", "repo": "VENIZIA-AI/ignis", "ref": "develop" }
  ]
}
