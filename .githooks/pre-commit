#!/bin/bash

# =============================================================================
# Pre-commit Hook
# Runs `make lint-all`: the packages, the wiki, scripts/ and the format of the files outside the projects (the examples among them).
# The examples resolve the packages through dist, so run `make build-all` after a pull.
# =============================================================================

set -e

echo "🔍 Running pre-commit checks..."
echo ""

# Get the root directory of the git repository
ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "📦 Linting everything..."
make lint-all

echo ""
echo "✅ Pre-commit checks passed!"
